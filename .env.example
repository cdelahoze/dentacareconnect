# ==========================================
# SERVER CONFIGURATION
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
# CORS Configuration
CLIENT_URL="http://localhost:3000"
# Control Engine Scheduler Configuration
ENABLE_CRON=true
CRON_SCHEDULE="0 0 * * *"
# Optional timezone (for example: "America/Bogota"); leave blank to use system local timezone
CRON_TIMEZONE=""
# Follow-up reminder window in days
REMINDER_WINDOW_DAYS=3

# ==========================================
# POSTGRESQL DATABASE CONNECTION STRINGS
# ==========================================

# Database Connection String (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/dentacare_db?schema=public"

# ==========================================
# TWILIO WHATSAPP & SMS GATEWAY (TSK-301 & TSK-302)
# ==========================================
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_FROM="whatsapp:+17372212163"
# Twilio SMS-capable phone number (E.164 format, e.g., +15017122661)
TWILIO_SMS_FROM="+15017122661"

# ==========================================
# AUTOMATED DAILY CRON JOB ENGINE (TSK-303)
# ==========================================
# Run daily at 08:00 AM America/Bogota time
REMINDER_CRON_SCHEDULE="0 8 * * *"
REMINDER_TIMEZONE="America/Bogota"
# Notify patients whose nextControlDate is within the next N days (default: 3 days)
REMINDER_LOOKAHEAD_DAYS=3
# Minimum hours between duplicate reminders for the same procedure (default: 24h)
REMINDER_COOLDOWN_HOURS=24
