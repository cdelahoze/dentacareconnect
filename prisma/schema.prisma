generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  DENTAL_ASSISTANT
  DENTIST
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum TreatmentStatus {
  PENDING_FOLLOWUP
  FOLLOWUP_SCHEDULED
  COMPLETED
  OVERDUE
  CANCELLED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReminderStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
  READ
}

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  password            String
  firstName           String
  lastName            String
  role                UserRole           @default(DENTAL_ASSISTANT)
  phone               String?
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  performedTreatments PatientProcedure[] @relation("PerformedByUser")
  appointments        Appointment[]      @relation("AssignedStaff")

  @@index([email])
  @@index([role])
  @@map("users")
}

model Patient {
  id                String              @id @default(uuid())
  firstName         String
  lastName          String
  email             String              @unique
  phone             String
  dateOfBirth       DateTime?
  gender            String?
  preferredChannel  NotificationChannel @default(WHATSAPP)
  clinicalNotes     String?             @db.Text
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  patientProcedures PatientProcedure[]
  appointments      Appointment[]
  reminders         Reminder[]

  @@index([email])
  @@index([phone])
  @@map("patients")
}

model Procedure {
  id                  String             @id @default(uuid())
  name                String             @unique
  code                String?            @unique
  description         String?            @db.Text
  defaultFollowUpDays Int
  category            String?
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  patientProcedures   PatientProcedure[]

  @@index([name])
  @@index([category])
  @@map("procedures")
}

model PatientProcedure {
  id              String          @id @default(uuid())
  patientId       String
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  procedureId     String
  procedure       Procedure       @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  performedById   String?
  performedBy     User?           @relation("PerformedByUser", fields: [performedById], references: [id], onDelete: SetNull)
  procedureDate   DateTime        @default(now())
  followUpDueDate DateTime
  status          TreatmentStatus @default(PENDING_FOLLOWUP)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  appointments    Appointment[]
  reminders       Reminder[]

  @@index([patientId])
  @@index([procedureId])
  @@index([performedById])
  @@index([followUpDueDate])
  @@index([status])
  @@map("patient_procedures")
}

model Appointment {
  id                 String            @id @default(uuid())
  patientId          String
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientProcedureId String?
  patientProcedure   PatientProcedure? @relation(fields: [patientProcedureId], references: [id], onDelete: SetNull)
  userId             String?
  user               User?             @relation("AssignedStaff", fields: [userId], references: [id], onDelete: SetNull)
  scheduledAt        DateTime
  durationMinutes    Int               @default(30)
  status             AppointmentStatus @default(PENDING)
  notes              String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  reminders          Reminder[]

  @@index([patientId])
  @@index([patientProcedureId])
  @@index([userId])
  @@index([scheduledAt])
  @@index([status])
  @@map("appointments")
}

model Reminder {
  id                 String              @id @default(uuid())
  patientId          String
  patient            Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientProcedureId String?
  patientProcedure   PatientProcedure?   @relation(fields: [patientProcedureId], references: [id], onDelete: SetNull)
  appointmentId      String?
  appointment        Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  channel            NotificationChannel
  status             ReminderStatus      @default(PENDING)
  scheduledFor       DateTime
  sentAt             DateTime?
  bookingToken       String              @unique @default(uuid())
  bookingUrl         String?
  messageContent     String?             @db.Text
  externalMessageId  String?             @unique
  errorMessage       String?             @db.Text
  retryCount         Int                 @default(0)
  maxRetries         Int                 @default(3)
  isEscalated        Boolean             @default(false)
  escalatedAt        DateTime?
  escalationNotes    String?             @db.Text
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([patientId])
  @@index([patientProcedureId])
  @@index([appointmentId])
  @@index([status])
  @@index([scheduledFor])
  @@index([channel])
  @@index([bookingToken])
  @@index([isEscalated])
  @@map("reminders")
}
